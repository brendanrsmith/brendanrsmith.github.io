---
// Lab zone — bare minimum wrapper for experiments.
// Each lab page can use this, or skip it entirely and write their own <html>.
// No Base, no global styles, no inherited anything.

interface Props {
  title?: string;
}

const { title = "Lab" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      *:where(:not(html, body)) {
        margin: 0;
        padding: 0;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        font-family: sans-serif;
        line-height: 1;
      }
      img,
      video,
      svg,
      canvas {
        display: block;
        max-width: 100%;
      }
      input,
      button,
      textarea,
      select {
        font: inherit;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
