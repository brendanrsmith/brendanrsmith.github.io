---
import Lab from "../../layouts/Lab.astro";
import BskySurf from "../../components/lab/BskySurf";
---

<Lab title="surf">
  <style is:global>
    body {
      background: #0a0a0a;
      color: #eee;
      font-family: monospace;
      padding: 2rem;
    }

    h1 {
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #555;
      margin-bottom: 2rem;
    }

    h1 a {
      color: #e0c4eb;
      text-decoration: none;
    }

    .info-wrap {
      display: inline-flex;
      position: relative;
      gap: 0.5rem;
    }

    .info-btn {
      background: none;
      border: none;
      color: #666;
      font-family: monospace;
      font-size: 0.85rem;
      padding: 0;
      cursor: pointer;
    }

    .info-btn:hover { color: #bbb; }

    #clear-btn {
      background: none;
      border: none;
      color: #444;
      font-family: monospace;
      font-size: 1.1rem;
      padding: 0;
      cursor: pointer;
      line-height: 1;
    }

    #clear-btn:hover { color: #aaa; }

    #status button {
      background: none;
      border: none;
      color: #888;
      font-family: monospace;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
    }

    #status button:hover { color: #eee; }

    .info-popover {
      position: fixed;
      top: 2rem;
      right: 2rem;
      background: #111;
      border: 1px solid #222;
      color: #888;
      font-size: 0.75rem;
      line-height: 1.6;
      padding: 0.75rem 1rem;
      width: 260px;
      box-sizing: border-box;
      z-index: 20;
      display: none;
    }

    .info-popover.open { display: block; }

    .stats-section {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .stats-divider {
      border-top: 1px solid #1e1e1e;
      margin: 0.5rem 0;
    }

    .stats-section-label {
      font-size: 0.6rem;
      color: #555;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.1rem;
    }

    .stats-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }

    .stats-row .sk { color: #777; }

    .stats-row .sv {
      color: #bbb;
      font-variant-numeric: tabular-nums;
    }

    /* layout */
    .layout {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 3rem;
      align-items: start;
      max-width: 960px;
    }

    /* prevent either column from blowing out the grid */
    .post-col, .chain-col { min-width: 0; }

    @media (max-width: 700px) {
      .layout { grid-template-columns: 1fr; }

      .post-col { order: -1; }

      .info-popover {
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        width: auto;
        max-height: 55vh;
        overflow-y: auto;
        border-left: none;
        border-right: none;
        border-bottom: none;
        border-top: 1px solid #2a2a2a;
        padding-bottom: max(1rem, env(safe-area-inset-bottom));
      }
    }

    /* chain column */
    .input-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    input {
      background: transparent;
      border: none;
      border-bottom: 1px solid #333;
      color: #eee;
      font-family: monospace;
      font-size: 16px;
      padding: 0.25rem 0;
      width: 240px;
      outline: none;
    }

    input::placeholder { color: #444; }

    .suggestions {
      position: absolute;
      top: 100%;
      left: 0;
      background: #111;
      border: 1px solid #222;
      width: 100%;
      z-index: 10;
    }

    .suggestions button {
      display: block;
      width: 100%;
      background: none;
      border: none;
      color: #aaa;
      font-family: monospace;
      font-size: 0.75rem;
      padding: 0.4rem 0.6rem;
      text-align: left;
      cursor: pointer;
    }

    .suggestions button:hover,
    .suggestions button.active {
      background: #1a1a1a;
      color: #eee;
    }

    .status-row {
      margin-top: 1.5rem;
      min-height: 1rem;
    }

    #status {
      font-size: 0.7rem;
      color: #777;
      min-height: 1.2em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .meta-row {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-top: 0.35rem;
    }

    #timer {
      font-size: 0.65rem;
      color: #333;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    #timer.stuck { color: #7a6830; }

    #depth {
      font-size: 0.65rem;
      color: #777;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    #skips {
      font-size: 0.65rem;
      color: #444;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    #chain {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      max-height: 70vh;
      overflow-y: auto;
      scrollbar-width: none;
      padding-left: 0.6rem;
    }

    #chain::-webkit-scrollbar { display: none; }

    .node {
      display: block;
    }

    .node-branches {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      margin-top: 0.4rem;
      margin-left: -1.2rem;
    }

    .branch-item {
      font-size: 0.6rem;
      color: #3a3a3a;
      line-height: 1.5;
    }

    .branch-item::before {
      content: "├─ ";
      color: #1e1e1e;
    }

    .branch-item:last-child::before {
      content: "╰─ ";
    }

    .branch-item a { color: inherit; text-decoration: none; }
    .branch-item a:hover { color: #666; }

    .node-info {
      border-left: 1px solid #1e1e1e;
      padding: 0 0 1.2rem 1rem;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .node-info::before {
      content: "●";
      position: absolute;
      left: -0.42em;
      top: 0;
      font-size: 0.55rem;
      color: #333;
      line-height: 1.6;
    }

    .node.current .node-info::before { color: #e0c4eb; }

    .node-handle {
      font-size: 0.82rem;
      color: #ccc;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .node-handle a { color: inherit; text-decoration: none; }
    .node-handle a:hover { color: #eee; }

    .node-via {
      font-size: 0.68rem;
      color: #666;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .node-via a { color: inherit; }
    .node-via a:hover { color: #aaa; }

    .node-meta {
      font-size: 0.62rem;
      color: #444;
    }

    .node.current .node-handle { color: #eee; }
    .node.current .node-via { color: #888; }

    .node.in-seed-graph .node-handle a { color: #e0c4eb; }

    .node.stuck .node-meta { color: #7a6830; }

    @keyframes node-in {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .node { animation: node-in 0.2s ease-out; }

    @keyframes post-in {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes post-out {
      from { opacity: 1; transform: translateY(0); }
      to   { opacity: 0; transform: translateY(8px); }
    }

    .post-panel-inner { animation: post-in 0.3s ease-out; }
    .post-panel-inner.exiting { animation: post-out 0.22s ease-in forwards; }

    /* post panel */
    #post-panel {
      position: sticky;
      top: 2rem;
    }

    .post-author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .post-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    .post-avatar-placeholder {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #1a1a1a;
      flex-shrink: 0;
    }

    .post-author-meta {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .post-display-name {
      font-size: 0.8rem;
      color: #eee;
    }

    .post-handle {
      font-size: 0.68rem;
      color: #666;
    }

    .post-text {
      font-size: 0.8rem;
      color: #ccc;
      line-height: 1.7;
      white-space: pre-wrap;
      word-break: break-word;
      margin-bottom: 1rem;
    }

    .post-images {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.4rem;
      margin-bottom: 1rem;
    }

    .post-images img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: contain;
      background: #111;
      display: block;
      border-radius: 2px;
    }

    .post-external {
      border: 1px solid #1e1e1e;
      padding: 0.6rem 0.75rem;
      margin-bottom: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      overflow: hidden;
      max-width: 100%;
      box-sizing: border-box;
    }

    .post-external-thumb {
      display: block;
      width: 100%;
      aspect-ratio: 1.91 / 1;
      max-height: 140px;
      object-fit: cover;
      background: #111;
      margin-bottom: 0.4rem;
    }

    .post-external-title {
      font-size: 0.72rem;
      color: #aaa;
    }

    .post-external-url {
      font-size: 0.62rem;
      color: #444;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .post-quote {
      border-left: 1px solid #222;
      padding-left: 0.75rem;
      margin-bottom: 1rem;
    }

    .post-quote-handle {
      font-size: 0.68rem;
      color: #777;
      margin-bottom: 0.3rem;
    }

    .post-quote-text {
      font-size: 0.72rem;
      color: #777;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .post-link {
      font-size: 0.65rem;
      color: #666;
      text-decoration: none;
    }

    .post-link:hover { color: #aaa; }

    .post-empty {
      font-size: 0.72rem;
      color: #2a2a2a;
    }

    .post-repost-label {
      font-size: 0.6rem;
      color: #555;
      letter-spacing: 0.04em;
      margin-bottom: 0.6rem;
    }
  </style>

  <BskySurf client:only="react" />
</Lab>
