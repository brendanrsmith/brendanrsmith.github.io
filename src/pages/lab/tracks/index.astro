---
import Lab from "../../../layouts/Lab.astro";

import fs from "fs";

let activities: any[] = [];
try {
  activities = JSON.parse(fs.readFileSync("src/data/strava.json", "utf-8"));
} catch {
  // Run: bun scripts/strava-fetch.ts
}
activities = activities.filter((a) => a.path);
---

<Lab title="tracks">
  <style is:global>
    body {
      background: #0a0a0a;
      color: #eee;
      font-family: monospace;
      letter-spacing: 0.05em;
      overflow: hidden;
    }

    h1 {
      font-size: 0.75rem;
      color: #555;
      position: fixed;
      z-index: 10;
      padding: 2rem;

      a {
        color: #e0c4eb;
      }
    }

    .empty {
      color: #555;
      font-size: 0.8rem;
    }

    .grid {
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      width: max(100vw, 100vh);
      height: max(100vw, 100vh);
      z-index: 0;
    }

    .card {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .card svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .card path {
      fill: none;
      stroke: #e0c4eb;
      stroke-width: 1;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
      pointer-events: stroke;
    }

    .card path:hover {
      stroke: #fff;
      stroke-width: 2;
    }

  </style>

  <h1>
    <a href="/lab">LAB</a> &GT; tracks
  </h1>

  {
    activities.length === 0 && (
      <p class="empty">No data yet — run: bun scripts/strava-fetch.ts</p>
    )
  }

  <div class="grid">
    {
      activities.map((a, i) => (
        <div class="card" style={`--i:${i}`}>
          <svg viewBox="0 0 1 1" xmlns="http://www.w3.org/2000/svg">
            {a.path && <path d={a.path} />}
          </svg>
        </div>
      ))
    }
  </div>

  <script is:inline>
    // vector-effect: non-scaling-stroke causes stroke-dasharray to operate in screen
    // pixels, so we compute path length in screen pixels = user-unit length * SVG size.
    var svgSize = Math.max(window.innerWidth, window.innerHeight);
    document.querySelectorAll('.card path').forEach(function(p) {
      var len = p.getTotalLength() * svgSize;
      p.style.strokeDasharray = String(len);
      p.style.strokeDashoffset = String(len);
    });
  </script>

  <script>
    var svgSize = Math.max(window.innerWidth, window.innerHeight);
    document.querySelectorAll<SVGPathElement>('.card path').forEach((path, i) => {
      setTimeout(() => {
        path.style.transition = 'stroke-dashoffset 2s ease';
        path.style.strokeDashoffset = '0';
      }, 100 + i * 150);
    });
  </script>
</Lab>
