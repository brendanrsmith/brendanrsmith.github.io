---
import Lab from "../../../layouts/Lab.astro";

import fs from "fs";

let activities: any[] = [];
try {
  activities = JSON.parse(fs.readFileSync("src/data/strava.json", "utf-8"));
} catch {
  // Run: bun scripts/strava-fetch.ts
}
activities = activities.filter((a) => a.path);

const categories = ["ski", "bike", "run"];
---

<Lab title="tracks">
  <style is:global>
    body {
      background: #0a0a0a;
      color: #eee;
      font-family: monospace;
      letter-spacing: 0.05em;
      overflow: hidden;
    }

    h1 {
      font-size: 0.75rem;
      color: #555;
      position: fixed;
      z-index: 10;
      padding: 2rem;

      a {
        color: #e0c4eb;
      }
    }

    .toggle {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      display: flex;
      gap: 0.5rem;
    }

    .toggle button {
      background: none;
      border: 1px solid #333;
      color: #555;
      font-family: monospace;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      padding: 0.35rem 0.75rem;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
    }

    .toggle button:hover {
      color: #eee;
      border-color: #666;
    }

    .toggle button.active {
      color: #e0c4eb;
      border-color: #e0c4eb;
    }

    .empty {
      color: #555;
      font-size: 0.8rem;
    }

    .grid {
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      width: max(100vw, 100vh);
      height: max(100vw, 100vh);
      z-index: 0;
    }

    .card {
      position: absolute;
      inset: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .card.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .card svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .card path {
      fill: none;
      stroke: #e0c4eb;
      stroke-width: 1;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
      pointer-events: stroke;
    }

    .card path:hover {
      stroke: #fff;
      stroke-width: 2;
    }
  </style>

  <h1>
    <a href="/lab">LAB</a> &GT; tracks
  </h1>

  {
    activities.length === 0 && (
      <p class="empty">No data yet — run: bun scripts/strava-fetch.ts</p>
    )
  }

  <div class="grid">
    {
      activities.map((a, i) => (
        <div class="card" data-category={a.category} style={`--i:${i}`}>
          <svg viewBox="0 0 1 1" xmlns="http://www.w3.org/2000/svg">
            {a.path && <path d={a.path} />}
          </svg>
        </div>
      ))
    }
  </div>

  <nav class="toggle">
    {categories.map((cat) => (
      <button data-cat={cat}>{cat}</button>
    ))}
  </nav>

  <script is:inline>
    var svgSize = Math.max(window.innerWidth, window.innerHeight);
    document.querySelectorAll('.card path').forEach(function(p) {
      var len = p.getTotalLength() * svgSize;
      p.style.strokeDasharray = String(len);
      p.style.strokeDashoffset = String(len);
    });
  </script>

  <script>
    const svgSize = Math.max(window.innerWidth, window.innerHeight);
    const cards = document.querySelectorAll<HTMLElement>('.card');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.toggle button');

    // Draw-in animation on load
    cards.forEach((card, i) => {
      const path = card.querySelector<SVGPathElement>('path');
      if (!path) return;
      setTimeout(() => {
        path.style.transition = 'stroke-dashoffset 2s ease';
        path.style.strokeDashoffset = '0';
      }, 100 + i * 150);
    });

    // Toggle filter
    let active: string | null = null;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat!;

        if (active === cat) {
          // Deselect — show all
          active = null;
          buttons.forEach((b) => b.classList.remove('active'));
          cards.forEach((c) => c.classList.remove('hidden'));
        } else {
          active = cat;
          buttons.forEach((b) => b.classList.toggle('active', b.dataset.cat === cat));
          cards.forEach((c) => {
            c.classList.toggle('hidden', c.dataset.category !== cat);
          });
        }
      });
    });
  </script>
</Lab>
