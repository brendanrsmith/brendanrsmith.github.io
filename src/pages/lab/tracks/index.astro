---
import Lab from "../../../layouts/Lab.astro";

import fs from "fs";

let activities: any[] = [];
try {
  activities = JSON.parse(fs.readFileSync("src/data/strava.json", "utf-8"));
} catch {
  // Run: bun scripts/strava-fetch.ts
}
activities = activities.filter((a) => a.path);

const categories = ["ski", "bike", "run"];

function fmtDistance(m: number) {
  return (m / 1000).toFixed(1) + " km";
}
function fmtTime(s: number) {
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
}
function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
---

<Lab title="tracks">
  <style is:global>
    body {
      background: #0a0a0a;
      color: #eee;
      font-family: monospace;
      letter-spacing: 0.05em;
      overflow: hidden;
    }

    h1 {
      font-size: 0.75rem;
      color: #555;
      position: fixed;
      z-index: 10;
      padding: 2rem;

      a {
        color: #e0c4eb;
      }
    }

    .toggle {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      display: flex;
      gap: 0.5rem;
    }

    .toggle button {
      background: none;
      border: 1px solid #333;
      color: #555;
      font-family: monospace;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      padding: 0.35rem 0.75rem;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
    }

    .toggle button:hover {
      color: #eee;
      border-color: #666;
    }

    .toggle button.active {
      color: #e0c4eb;
      border-color: #e0c4eb;
    }

    .empty {
      color: #555;
      font-size: 0.8rem;
    }

    .grid {
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      width: max(100vw, 100vh);
      height: max(100vw, 100vh);
      z-index: 0;
    }

    .card {
      position: absolute;
      inset: 0;
      pointer-events: none;
      visibility: hidden;
    }

    .card.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .card.hidden path {
      pointer-events: none;
    }

    .card svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .card path {
      fill: none;
      stroke: #e0c4eb;
      stroke-width: 1;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
      pointer-events: stroke;
      cursor: pointer;
    }

    .card path:hover,
    .card.active path {
      stroke: #fff;
      stroke-width: 2;
    }

    .tooltip {
      position: fixed;
      z-index: 20;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s ease;
      background: #111;
      border: 1px solid #333;
      padding: 0.6rem 0.8rem;
      font-size: 0.7rem;
      line-height: 1.8;
      white-space: nowrap;
    }

    .tooltip.visible {
      opacity: 1;
    }

    .tooltip-name {
      color: #eee;
      margin-bottom: 0.2rem;
    }

    .tooltip-meta {
      color: #555;
    }

    .tooltip-meta span {
      color: #999;
    }
  </style>

  <h1>
    <a href="/lab">LAB</a> &GT; tracks
  </h1>

  {
    activities.length === 0 && (
      <p class="empty">No data yet — run: bun scripts/strava-fetch.ts</p>
    )
  }

  <div class="grid">
    {
      activities.map((a, i) => (
        <div
          class="card"
          data-category={a.category}
          data-name={a.name}
          data-date={fmtDate(a.date)}
          data-distance={fmtDistance(a.distance)}
          data-time={fmtTime(a.moving_time)}
          data-elevation={a.elevation_gain + " m"}
          style={`--i:${i}`}
        >
          <svg viewBox="0 0 1 1" xmlns="http://www.w3.org/2000/svg">
            {a.path && <path d={a.path} />}
          </svg>
        </div>
      ))
    }
  </div>

  <nav class="toggle">
    {categories.map((cat) => (
      <button data-cat={cat}>{cat}</button>
    ))}
  </nav>

  <div class="tooltip" id="tooltip">
    <div class="tooltip-name" id="tooltip-name"></div>
    <div class="tooltip-meta">date&nbsp;&nbsp;&nbsp; <span id="tooltip-date"></span></div>
    <div class="tooltip-meta">dist&nbsp;&nbsp;&nbsp; <span id="tooltip-dist"></span></div>
    <div class="tooltip-meta">time&nbsp;&nbsp;&nbsp; <span id="tooltip-time"></span></div>
    <div class="tooltip-meta">elev&nbsp;&nbsp;&nbsp; <span id="tooltip-elev"></span></div>
  </div>

  <script>
    const svgSize = Math.max(window.innerWidth, window.innerHeight);
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
    const buttons = document.querySelectorAll<HTMLButtonElement>('.toggle button');
    const tooltip = document.getElementById('tooltip')!;

    // Pre-compute dasharray for all paths, then reveal cards.
    cards.forEach((card) => {
      const path = card.querySelector<SVGPathElement>('path');
      if (!path) return;
      const len = path.getTotalLength() * svgSize;
      path.style.strokeDasharray = String(len);
      path.style.strokeDashoffset = String(len);
      card.style.visibility = 'visible';
    });

    let pendingTimers: ReturnType<typeof setTimeout>[] = [];

    function animateVisible() {
      pendingTimers.forEach(clearTimeout);
      pendingTimers = [];

      const visible = cards.filter((c) => !c.classList.contains('hidden'));
      visible.forEach((card, i) => {
        const path = card.querySelector<SVGPathElement>('path');
        if (!path) return;
        path.style.transition = 'none';
        path.style.strokeDashoffset = path.style.strokeDasharray;
        const t = setTimeout(() => {
          path.style.transition = 'stroke-dashoffset 1.5s ease';
          path.style.strokeDashoffset = '0';
        }, i * 60);
        pendingTimers.push(t);
      });
    }

    animateVisible();

    // Tooltip
    let activeCard: HTMLElement | null = null;

    function showTooltip(card: HTMLElement, x: number, y: number) {
      document.getElementById('tooltip-name')!.textContent = card.dataset.name ?? '';
      document.getElementById('tooltip-date')!.textContent = card.dataset.date ?? '';
      document.getElementById('tooltip-dist')!.textContent = card.dataset.distance ?? '';
      document.getElementById('tooltip-time')!.textContent = card.dataset.time ?? '';
      document.getElementById('tooltip-elev')!.textContent = card.dataset.elevation ?? '';
      positionTooltip(x, y);
      tooltip.classList.add('visible');
    }

    function positionTooltip(x: number, y: number) {
      const pad = 12;
      const tw = tooltip.offsetWidth;
      const th = tooltip.offsetHeight;
      const left = x + pad + tw > window.innerWidth ? x - tw - pad : x + pad;
      const top  = y + pad + th > window.innerHeight ? y - th - pad : y + pad;
      tooltip.style.left = left + 'px';
      tooltip.style.top  = top  + 'px';
    }

    function hideTooltip() {
      tooltip.classList.remove('visible');
      activeCard?.classList.remove('active');
      activeCard = null;
    }

    cards.forEach((card) => {
      card.querySelector('path')?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (activeCard === card) {
          hideTooltip();
          return;
        }
        activeCard?.classList.remove('active');
        activeCard = card;
        card.classList.add('active');
        showTooltip(card, (e as MouseEvent).clientX, (e as MouseEvent).clientY);
      });
    });

    document.addEventListener('click', hideTooltip);

    // Filter toggle
    let active: string | null = null;

    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        hideTooltip();
        const cat = btn.dataset.cat!;

        if (active === cat) {
          active = null;
          buttons.forEach((b) => b.classList.remove('active'));
          cards.forEach((c) => c.classList.remove('hidden'));
        } else {
          active = cat;
          buttons.forEach((b) => b.classList.toggle('active', b.dataset.cat === cat));
          cards.forEach((c) => {
            c.classList.toggle('hidden', c.dataset.category !== cat);
          });
        }

        animateVisible();
      });
    });
  </script>
</Lab>
