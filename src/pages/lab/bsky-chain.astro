---
import Lab from "../../layouts/Lab.astro";
---

<Lab title="chain">
  <style is:global>
    body {
      background: #0a0a0a;
      color: #eee;
      font-family: monospace;
      padding: 2rem;
    }

    h1 {
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #555;
      margin-bottom: 2rem;
    }

    h1 a {
      color: #e0c4eb;
      text-decoration: none;
    }

    .info-wrap {
      display: inline-block;
      position: relative;
    }

    .info-btn {
      background: none;
      border: none;
      color: #666;
      font-family: monospace;
      font-size: 0.7rem;
      padding: 0;
      cursor: pointer;
    }

    .info-btn:hover { color: #bbb; }

    .info-popover {
      position: absolute;
      top: 1.4rem;
      left: 0;
      background: #111;
      border: 1px solid #222;
      color: #888;
      font-size: 0.68rem;
      line-height: 1.6;
      padding: 0.75rem 1rem;
      width: 280px;
      z-index: 20;
      display: none;
    }

    .info-popover.open { display: block; }

    .stats-popover {
      position: fixed;
      top: 2rem;
      right: 2rem;
      left: auto;
      width: 220px;
      display: none;
    }

    .stats-popover.open { display: block; }

    .stats-section {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .stats-divider {
      border-top: 1px solid #1e1e1e;
      margin: 0.5rem 0;
    }

    .stats-section-label {
      font-size: 0.6rem;
      color: #555;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.1rem;
    }

    .stats-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }

    .stats-row .sk { color: #777; }

    .stats-row .sv {
      color: #bbb;
      font-variant-numeric: tabular-nums;
    }

    /* layout */
    .layout {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 3rem;
      align-items: start;
      max-width: 960px;
    }

    @media (max-width: 700px) {
      .layout { grid-template-columns: 1fr; }
      .node-branches { display: none; }
    }

    /* chain column */
    .input-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    input {
      background: transparent;
      border: none;
      border-bottom: 1px solid #333;
      color: #eee;
      font-family: monospace;
      font-size: 0.85rem;
      padding: 0.25rem 0;
      width: 240px;
      outline: none;
    }

    input::placeholder { color: #444; }

    .suggestions {
      position: absolute;
      top: 100%;
      left: 0;
      background: #111;
      border: 1px solid #222;
      width: 100%;
      z-index: 10;
    }

    .suggestions button {
      display: block;
      width: 100%;
      background: none;
      border: none;
      color: #aaa;
      font-family: monospace;
      font-size: 0.75rem;
      padding: 0.4rem 0.6rem;
      text-align: left;
      cursor: pointer;
    }

    .suggestions button:hover,
    .suggestions button.active {
      background: #1a1a1a;
      color: #eee;
    }

    .status-row {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-top: 1.5rem;
      min-height: 1rem;
    }

    #status {
      font-size: 0.7rem;
      color: #777;
      flex: 1;
      min-height: 1.2em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    #depth {
      font-size: 0.65rem;
      color: #444;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    #depth.nonzero { color: #777; }

    #chain {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      max-height: 70vh;
      overflow-y: auto;
      scrollbar-width: none;
    }

    #chain::-webkit-scrollbar { display: none; }

    .node {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: 0.75rem;
      align-items: start;
    }

    .node-branches {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      align-items: flex-end;
      padding-top: 0.15rem;
      padding-right: 0.25rem;
    }

    .branch-item {
      font-size: 0.6rem;
      color: #3a3a3a;
      text-align: right;
      line-height: 1.5;
    }

    .branch-item a { color: inherit; text-decoration: none; }
    .branch-item a:hover { color: #666; }

    .node-info {
      border-left: 1px solid #1e1e1e;
      padding: 0 0 1.2rem 1rem;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .node-info::before {
      content: "●";
      position: absolute;
      left: -0.42em;
      top: 0;
      font-size: 0.55rem;
      color: #333;
      line-height: 1.6;
    }

    .node.current .node-info::before { color: #e0c4eb; }

    .node-handle {
      font-size: 0.82rem;
      color: #ccc;
    }

    .node-handle a { color: inherit; text-decoration: none; }
    .node-handle a:hover { color: #eee; }

    .node-via {
      font-size: 0.68rem;
      color: #666;
    }

    .node-via a { color: inherit; }
    .node-via a:hover { color: #aaa; }

    .node-meta {
      font-size: 0.62rem;
      color: #444;
    }

    .node.current .node-handle { color: #eee; }
    .node.current .node-via { color: #888; }

    @keyframes node-in {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .node { animation: node-in 0.2s ease-out; }

    @keyframes post-in {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes post-out {
      from { opacity: 1; transform: translateY(0); }
      to   { opacity: 0; transform: translateY(8px); }
    }

    /* post panel */
    #post-panel {
      position: sticky;
      top: 2rem;
    }

    .post-author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .post-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    .post-avatar-placeholder {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #1a1a1a;
      flex-shrink: 0;
    }

    .post-author-meta {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .post-display-name {
      font-size: 0.8rem;
      color: #eee;
    }

    .post-handle {
      font-size: 0.68rem;
      color: #666;
    }

    .post-text {
      font-size: 0.8rem;
      color: #ccc;
      line-height: 1.7;
      white-space: pre-wrap;
      word-break: break-word;
      margin-bottom: 1rem;
    }

    .post-images {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.4rem;
      margin-bottom: 1rem;
    }

    .post-images img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: contain;
      background: #111;
      display: block;
      border-radius: 2px;
    }

    .post-external {
      border: 1px solid #1e1e1e;
      padding: 0.6rem 0.75rem;
      margin-bottom: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .post-external-thumb {
      width: 100%;
      max-height: 140px;
      object-fit: contain;
      background: #111;
      margin-bottom: 0.4rem;
    }

    .post-external-title {
      font-size: 0.72rem;
      color: #aaa;
    }

    .post-external-url {
      font-size: 0.62rem;
      color: #444;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .post-quote {
      border-left: 1px solid #222;
      padding-left: 0.75rem;
      margin-bottom: 1rem;
    }

    .post-quote-handle {
      font-size: 0.68rem;
      color: #777;
      margin-bottom: 0.3rem;
    }

    .post-quote-text {
      font-size: 0.72rem;
      color: #777;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .post-link {
      font-size: 0.65rem;
      color: #666;
      text-decoration: none;
    }

    .post-link:hover { color: #aaa; }

    .post-empty {
      font-size: 0.72rem;
      color: #2a2a2a;
    }
  </style>

  <h1><a href="/lab">lab</a> &gt; chain</h1>

  <div class="layout">
    <div class="chain-col">
      <div class="input-wrap">
        <input id="handle" type="text" placeholder="seed handle" autocomplete="off" autocapitalize="off" spellcheck="false" />
        <div class="suggestions" id="suggestions" hidden></div>
        <span class="info-wrap">
          <button class="info-btn" id="info-btn">?</button>
          <button class="info-btn" id="stats-btn">i</button>
          <div class="info-popover" id="info-popover">
            watch for likes, reposts, and posts from the current seed's follows → first event extracts the target post's author → resolves to a handle → that author becomes the new seed
          </div>
          <div class="info-popover stats-popover" id="stats-popover">
            <div class="stats-section">
              <div class="stats-section-label">session</div>
              <div class="stats-row"><span class="sk">hops</span><span class="sv" id="sv-hops">—</span></div>
              <div class="stats-row"><span class="sk">skips</span><span class="sv" id="sv-skipped">—</span></div>
            </div>
            <div class="stats-divider"></div>
            <div class="stats-section">
              <div class="stats-section-label">from follows</div>
              <div class="stats-row"><span class="sk">likes</span><span class="sv" id="sv-p-like">—</span></div>
              <div class="stats-row"><span class="sk">reposts</span><span class="sv" id="sv-p-repost">—</span></div>
              <div class="stats-row"><span class="sk">posts</span><span class="sv" id="sv-p-post">—</span></div>
              <div class="stats-row"><span class="sk">follows</span><span class="sv" id="sv-p-follow">—</span></div>
            </div>
            <div class="stats-divider"></div>
            <div class="stats-section">
              <div class="stats-section-label">chain</div>
              <div class="stats-row"><span class="sk">triggered</span><span class="sv" id="sv-triggered">—</span></div>
              <div class="stats-row"><span class="sk">branches</span><span class="sv" id="sv-branches">—</span></div>
            </div>
          </div>
        </span>
      </div>
      <div class="status-row">
        <div id="status"></div>
        <div id="depth"></div>
      </div>
      <div id="chain"></div>
    </div>
    <div class="post-col">
      <div id="post-panel"><p class="post-empty">—</p></div>
    </div>
  </div>

  <script>
    const API = "https://public.api.bsky.app/xrpc";
    const JETSTREAM = "wss://jetstream2.us-east.bsky.network/subscribe";
    const MAX_FOLLOWS = 10000;
    const MIN_FOLLOWS = 10;

    async function xrpc(method, params = {}) {
      const url = new URL(`${API}/${method}`);
      for (const [k, v] of Object.entries(params)) {
        if (v != null) url.searchParams.set(k, v);
      }
      const res = await fetch(url);
      if (!res.ok) throw new Error(`${res.status}`);
      return res.json();
    }

    function didFromUri(uri) {
      const m = uri?.match(/^at:\/\/(did:[^/]+)\//);
      return m ? m[1] : null;
    }

    function postUrlFromUri(uri) {
      return uri?.replace(/^at:\/\/(did:[^/]+)\/app\.bsky\.feed\.post\/(.+)$/, "https://bsky.app/profile/$1/post/$2") ?? "#";
    }

    function escapeHtml(s) {
      return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    // --- info popover ---
    const infoBtn = document.getElementById("info-btn");
    const infoPopover = document.getElementById("info-popover");
    infoBtn.addEventListener("click", (e) => { e.stopPropagation(); statsPopover.classList.remove("open"); infoPopover.classList.toggle("open"); });
    document.addEventListener("click", () => { infoPopover.classList.remove("open"); });

    // --- stats ---
    const statsBtn = document.getElementById("stats-btn");
    const statsPopover = document.getElementById("stats-popover");
    statsBtn.addEventListener("click", (e) => { e.stopPropagation(); infoPopover.classList.remove("open"); statsPopover.classList.toggle("open"); updateStatsDisplay(); });

    const stats = { hops: 0, processed: { like: 0, repost: 0, post: 0, follow: 0 }, triggered: 0, branches: 0, skipped: 0 };

    function resetStats() {
      stats.hops = 0; stats.processed.like = 0; stats.processed.repost = 0;
      stats.processed.post = 0; stats.processed.follow = 0;
      stats.triggered = 0; stats.branches = 0; stats.skipped = 0;
      updateStatsDisplay();
    }

    function updateStatsDisplay() {
      if (!statsPopover.classList.contains("open")) return;
      const f = n => n === 0 ? "—" : n.toLocaleString();
      document.getElementById("sv-hops").textContent      = f(stats.hops);
      document.getElementById("sv-skipped").textContent   = f(stats.skipped);
      document.getElementById("sv-p-like").textContent    = f(stats.processed.like);
      document.getElementById("sv-p-repost").textContent  = f(stats.processed.repost);
      document.getElementById("sv-p-post").textContent    = f(stats.processed.post);
      document.getElementById("sv-p-follow").textContent  = f(stats.processed.follow);
      document.getElementById("sv-triggered").textContent = f(stats.triggered);
      document.getElementById("sv-branches").textContent  = f(stats.branches);
    }

    // --- elements ---
    const input = document.getElementById("handle");
    const suggestionsEl = document.getElementById("suggestions");
    const statusEl = document.getElementById("status");
    const depthEl = document.getElementById("depth");
    const chainEl = document.getElementById("chain");
    const postPanel = document.getElementById("post-panel");

    let debounceTimer, activeIdx = -1;
    let ws = null;
    let profiles = {};
    let running = false;
    let hopping = false;
    let depth = 0;
    let currentNode = null;
    let shadowCount = 0;
    const MAX_SHADOWS = 8;

    // --- typeahead ---
    input.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      const q = input.value.trim().replace(/^@/, "");
      if (q.length < 2) { hideSuggestions(); return; }
      debounceTimer = setTimeout(() => fetchSuggestions(q), 200);
    });

    input.addEventListener("keydown", (e) => {
      const btns = suggestionsEl.querySelectorAll("button");
      if (e.key === "ArrowDown") { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, btns.length - 1); updateActive(btns); }
      else if (e.key === "ArrowUp") { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, -1); updateActive(btns); }
      else if (e.key === "Enter") {
        e.preventDefault();
        if (activeIdx >= 0 && btns[activeIdx]) btns[activeIdx].click();
        else start(input.value.trim().replace(/^@/, ""));
      } else if (e.key === "Escape") hideSuggestions();
    });

    function updateActive(btns) { btns.forEach((b, i) => b.classList.toggle("active", i === activeIdx)); }

    async function fetchSuggestions(q) {
      try {
        const { actors } = await xrpc("app.bsky.actor.searchActorsTypeahead", { q, limit: 6 });
        if (!actors.length) { hideSuggestions(); return; }
        suggestionsEl.innerHTML = "";
        activeIdx = -1;
        for (const actor of actors) {
          const btn = document.createElement("button");
          btn.textContent = actor.handle;
          btn.addEventListener("click", () => { input.value = actor.handle; hideSuggestions(); start(actor.handle); });
          suggestionsEl.appendChild(btn);
        }
        suggestionsEl.hidden = false;
      } catch {}
    }

    function hideSuggestions() { suggestionsEl.hidden = true; suggestionsEl.innerHTML = ""; activeIdx = -1; }
    document.addEventListener("click", (e) => { if (!e.target.closest(".input-wrap")) hideSuggestions(); });

    // --- chain ---
    async function start(actor) {
      hideSuggestions();
      stop();
      chainEl.innerHTML = "";
      postPanel.innerHTML = `<p class="post-empty">—</p>`;
      depth = 0;
      setDepth(0);
      running = true;
      resetStats();

      let seedPost = null;
      try {
        const feed = await xrpc("app.bsky.feed.getAuthorFeed", { actor, filter: "posts_no_replies", limit: 1 });
        seedPost = feed.feed?.[0]?.post ?? null;
      } catch {}

      await hop(actor, null, null, seedPost);
    }

    function stop() {
      running = false;
      hopping = false;
      if (ws) { ws.close(); ws = null; }
      profiles = {};
      currentNode = null;
      shadowCount = 0;
    }

    async function hop(actor, viaText, likedUri, post) {
      if (!running) return;
      hopping = true;

      shadowCount = 0;
      if (viaText) stats.hops++;

      chainEl.querySelectorAll(".node.current").forEach(n => n.classList.remove("current"));
      setDepth(depth++);

      // chain node
      const node = document.createElement("div");
      node.className = "node current";
      currentNode = node;

      const branchesEl = document.createElement("div");
      branchesEl.className = "node-branches";
      node.appendChild(branchesEl);

      const infoEl = document.createElement("div");
      infoEl.className = "node-info";

      const handleEl = document.createElement("div");
      handleEl.className = "node-handle";
      handleEl.innerHTML = `<a href="https://bsky.app/profile/${encodeURIComponent(actor)}" target="_blank" rel="noopener">@${escapeHtml(actor)}</a>`;
      infoEl.appendChild(handleEl);

      if (viaText) {
        const viaEl = document.createElement("div");
        viaEl.className = "node-via";
        viaEl.innerHTML = likedUri
          ? `${escapeHtml(viaText)} · <a href="${postUrlFromUri(likedUri)}" target="_blank" rel="noopener">↗</a>`
          : escapeHtml(viaText);
        infoEl.appendChild(viaEl);
      }

      const metaEl = document.createElement("div");
      metaEl.className = "node-meta";
      metaEl.textContent = new Date().toISOString().slice(11, 19) + " UTC";
      infoEl.appendChild(metaEl);

      node.appendChild(infoEl);
      chainEl.prepend(node);

      // update post panel
      if (post) renderPost(post, likedUri);

      // fetch follows
      setStatus(`fetching follows for @${actor}…`);
      try {
        profiles = await fetchFollows(actor);
      } catch {
        setStatus(`could not fetch follows for @${actor}`);
        running = false;
        return;
      }

      const count = Object.keys(profiles).length;
      if (count === 0) {
        setStatus(`@${actor} has no follows — chain ends`);
        running = false;
        return;
      }

      if (!running) return;

      if (ws) { ws.close(); ws = null; }
      const url = new URL(JETSTREAM);
      for (const col of ["app.bsky.feed.like", "app.bsky.feed.repost", "app.bsky.feed.post", "app.bsky.graph.follow"]) {
        url.searchParams.append("wantedCollections", col);
      }
      ws = new WebSocket(url);

      ws.addEventListener("open", () => {
        if (!running) { ws.close(); return; }
        hopping = false;
        setStatus(`watching @${actor}'s ${count} follows`);
      });

      ws.addEventListener("close", (e) => { if (running) setStatus(`disconnected (code ${e.code})`); });

      ws.addEventListener("message", async (e) => {
        if (!running) return;
        try {
          const evt = JSON.parse(e.data);
          if (evt.kind !== "commit" || evt.commit?.operation !== "create") return;
          if (!profiles[evt.did]) return;

          const col = evt.commit.collection;
          if (col === "app.bsky.feed.like") stats.processed.like++;
          else if (col === "app.bsky.feed.repost") stats.processed.repost++;
          else if (col === "app.bsky.feed.post") stats.processed.post++;
          else if (col === "app.bsky.graph.follow") stats.processed.follow++;
          updateStatsDisplay();

          if (hopping) {
            if (shadowCount < MAX_SHADOWS) {
              const actorHandle = profiles[evt.did];
              let verb, url;
              if (col === "app.bsky.feed.like") {
                const uri = evt.commit.record?.subject?.uri;
                if (uri) { verb = "liked"; url = postUrlFromUri(uri); }
              } else if (col === "app.bsky.feed.repost") {
                const uri = evt.commit.record?.subject?.uri;
                if (uri) { verb = "reposted"; url = postUrlFromUri(uri); }
              } else if (col === "app.bsky.feed.post") {
                verb = "posted";
                url = postUrlFromUri(`at://${evt.did}/app.bsky.feed.post/${evt.commit.rkey}`);
              } else if (col === "app.bsky.graph.follow") {
                const did = evt.commit.record?.subject;
                if (did) { verb = "followed"; url = `https://bsky.app/profile/${did}`; }
              }
              if (verb && url) addShadow(verb, actorHandle, url);
            }
            return;
          }

          let targetDid, targetUri, verb;

          if (col === "app.bsky.feed.like" || col === "app.bsky.feed.repost") {
            targetUri = evt.commit.record?.subject?.uri;
            if (!targetUri) return;
            targetDid = didFromUri(targetUri);
            if (!targetDid) return;
            verb = col === "app.bsky.feed.like" ? "liked" : "reposted";
          } else if (col === "app.bsky.feed.post") {
            targetDid = evt.did;
            targetUri = `at://${evt.did}/app.bsky.feed.post/${evt.commit.rkey}`;
            verb = "posted";
          } else if (col === "app.bsky.graph.follow") {
            targetDid = evt.commit.record?.subject;
            if (!targetDid) return;
            verb = "followed";
          } else {
            return;
          }

          hopping = true;
          stats.triggered++;
          const actorHandle = profiles[evt.did];
          setStatus(`@${actorHandle} ${verb} — resolving…`);

          const [profileRes, postsRes] = await Promise.allSettled([
            xrpc("app.bsky.actor.getProfile", { actor: targetDid }),
            targetUri ? xrpc("app.bsky.feed.getPosts", { uris: targetUri }) : Promise.resolve(null),
          ]);

          if (profileRes.status !== "fulfilled") { hopping = false; return; }
          const profile = profileRes.value;
          const followsCount = profile.followsCount ?? 0;

          if (followsCount < MIN_FOLLOWS) {
            stats.skipped++;
            setStatus(`skipping @${profile.handle} (${followsCount} follows) — waiting…`);
            hopping = false;
            return;
          }

          const post = (targetUri && postsRes.status === "fulfilled") ? postsRes.value.posts?.[0] : null;
          const viaText = col === "app.bsky.feed.post" ? "posted" : `${verb} by @${actorHandle}`;
          await hop(profile.handle, viaText, targetUri, post);
        } catch {}
      });
    }

    function addShadow(verb, actorHandle, url) {
      if (!currentNode) return;
      const el = document.createElement("div");
      el.className = "branch-item";
      el.innerHTML = `${escapeHtml(verb)} @${escapeHtml(actorHandle)} · <a href="${url}" target="_blank" rel="noopener">↗</a>`;
      currentNode.querySelector(".node-branches").appendChild(el);
      shadowCount++;
      stats.branches++;
    }

    // --- post panel renderer ---

    let renderTimer = null;

    function renderPost(post, uri) {
      clearTimeout(renderTimer);
      const hasContent = !postPanel.querySelector(".post-empty");
      if (hasContent) {
        postPanel.style.animation = "post-out 0.12s ease-in forwards";
        renderTimer = setTimeout(() => buildPost(post, uri), 120);
      } else {
        buildPost(post, uri);
      }
    }

    function buildPost(post, uri) {
      postPanel.style.animation = "";
      postPanel.innerHTML = "";

      // author
      const authorEl = document.createElement("div");
      authorEl.className = "post-author";
      if (post.author?.avatar) {
        authorEl.innerHTML = `<img class="post-avatar" src="${escapeHtml(post.author.avatar)}" alt="" />`;
      } else {
        authorEl.innerHTML = `<div class="post-avatar-placeholder"></div>`;
      }
      const metaEl = document.createElement("div");
      metaEl.className = "post-author-meta";
      metaEl.innerHTML = `
        <span class="post-display-name">${escapeHtml(post.author?.displayName || post.author?.handle || "")}</span>
        <span class="post-handle">@${escapeHtml(post.author?.handle || "")}</span>
      `;
      authorEl.appendChild(metaEl);
      postPanel.appendChild(authorEl);

      // text
      const text = post.record?.text?.trim();
      if (text) {
        const textEl = document.createElement("div");
        textEl.className = "post-text";
        textEl.textContent = text;
        postPanel.appendChild(textEl);
      }

      // embed
      const embed = post.embed;
      if (embed) renderEmbed(embed, postPanel);

      // link to post
      if (uri) {
        const linkEl = document.createElement("a");
        linkEl.className = "post-link";
        linkEl.href = postUrlFromUri(uri);
        linkEl.target = "_blank";
        linkEl.rel = "noopener";
        linkEl.textContent = "view on bsky.app ↗";
        postPanel.appendChild(linkEl);
      }

      void postPanel.offsetWidth;
      postPanel.style.animation = "post-in 0.2s ease-out";
      postPanel.addEventListener("animationend", () => { postPanel.style.animation = ""; }, { once: true });
    }

    function renderEmbed(embed, container) {
      const type = embed.$type;

      if (type === "app.bsky.embed.images#view" && embed.images?.length) {
        const grid = document.createElement("div");
        grid.className = "post-images";
        for (const img of embed.images) {
          const el = document.createElement("img");
          el.src = img.thumb;
          el.alt = img.alt || "";
          grid.appendChild(el);
        }
        container.appendChild(grid);
      }

      else if (type === "app.bsky.embed.external#view" && embed.external) {
        const ext = embed.external;
        const el = document.createElement("div");
        el.className = "post-external";
        if (ext.thumb) {
          const thumb = document.createElement("img");
          thumb.className = "post-external-thumb";
          thumb.src = ext.thumb;
          thumb.alt = "";
          el.appendChild(thumb);
        }
        if (ext.title) {
          const title = document.createElement("div");
          title.className = "post-external-title";
          title.textContent = ext.title;
          el.appendChild(title);
        }
        const urlEl = document.createElement("div");
        urlEl.className = "post-external-url";
        urlEl.textContent = ext.uri;
        el.appendChild(urlEl);
        container.appendChild(el);
      }

      else if (type === "app.bsky.embed.record#view" && embed.record) {
        renderQuote(embed.record, container);
      }

      else if (type === "app.bsky.embed.recordWithMedia#view") {
        if (embed.media) renderEmbed(embed.media, container);
        if (embed.record?.record) renderQuote(embed.record.record, container);
      }
    }

    function renderQuote(record, container) {
      if (!record.value && !record.record) return;
      const inner = record.value ?? record.record;
      const author = record.author;
      const el = document.createElement("div");
      el.className = "post-quote";
      if (author) {
        const handleEl = document.createElement("div");
        handleEl.className = "post-quote-handle";
        handleEl.textContent = `@${author.handle}`;
        el.appendChild(handleEl);
      }
      if (inner?.text) {
        const textEl = document.createElement("div");
        textEl.className = "post-quote-text";
        textEl.textContent = inner.text;
        el.appendChild(textEl);
      }
      container.appendChild(el);
    }

    async function fetchFollows(actor) {
      const result = {};
      let cursor;
      do {
        const res = await xrpc("app.bsky.graph.getFollows", { actor, limit: 100, cursor });
        for (const f of res.follows) result[f.did] = f.handle;
        cursor = res.cursor;
      } while (cursor && Object.keys(result).length < MAX_FOLLOWS);
      return result;
    }

    function setStatus(msg) { statusEl.textContent = msg; }

    function setDepth(n) {
      depthEl.textContent = n > 1 ? `${n} hops` : "";
      depthEl.classList.toggle("nonzero", n > 0);
    }
  </script>
